# Duplicate this file as .env.development and set values for your target project.
VITE_API_ROOT=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
# Bật khi API check-in và walk-in hỗ trợ lưu intake (BE PR #40).
VITE_ENABLE_RECEPTION_INTAKE=false
# Chỉ bật cùng cờ intake khi BE hỗ trợ phân công theo specialty (chưa có ở PR #40).
VITE_ENABLE_RECEPTION_SPECIALTY_ROUTING=false
